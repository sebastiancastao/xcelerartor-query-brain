# Xcelerator ClientPortal credentials (session-based login, not an API key).
# See src/lib/xcelerator-portal.ts. Copy this file to .env.local and fill in.

# Defaults to https://skylinecourierlogistics.com/Xcelerator if unset.
XCELERATOR_PORTAL_BASE_URL=

# Callers: every ClientPortal username is a caller, and every one listed here
# is checked the same way by order lookup and caller search, so a CSR doesn't
# need to know up front which caller an order shows under. Numbered from 1 up
# to 20; add another by using the next number. List order only breaks ties if
# the same reference number exists under two callers (earlier wins). _NAME is
# an optional display label shown in the UI instead of the raw username. This
# is not Xcelerator's "account" (AccountNo, see AXIS_ACCOUNT_NO below).
XCELERATOR_CALLER_1_USERNAME=
XCELERATOR_CALLER_1_PASSWORD=
XCELERATOR_CALLER_1_NAME=

XCELERATOR_CALLER_2_USERNAME=
XCELERATOR_CALLER_2_PASSWORD=
XCELERATOR_CALLER_2_NAME=

# Older single-caller settings, still honored ONLY when no
# XCELERATOR_CALLER_N_* above is set: XCELERATOR_LOOKUP_USERNAME/PASSWORD
# wins if both are set, else XCELERATOR_USERNAME/PASSWORD.
XCELERATOR_USERNAME=
XCELERATOR_PASSWORD=
XCELERATOR_LOOKUP_USERNAME=
XCELERATOR_LOOKUP_PASSWORD=

# Optional filters for completed-order range queries. Defaults match the
# portal's all/default values.
XCELERATOR_TRACKING_CLIENT_IDS=
XCELERATOR_TRACKING_SERVICE_IDS=
XCELERATOR_TRACKING_VEHICLE_IDS=
XCELERATOR_TRACKING_PACKAGE_IDS=
XCELERATOR_ORDER_QUERY_TARGET_BUFFER_DAYS=

# Comma-separated Xcelerator AccountNo codes (e.g. "FR8T,AJWOR") to scope
# every ClientPortal bulk/list query to — getCompletedOrdersFromXcelerator,
# getAllOrdersFromXceleratorPortal, and the reference-lookup bulk-search
# fallback in xcelerator.ts. Confirmed live: the portal's getorders ClientIDs
# param only accepts numeric ids (an account code there 500s), so this
# filters client-side on each row's own AccountNo field instead. Leave blank
# to see every account (no scoping).
AXIS_ACCOUNT_NO=

# Real Axis REST API (see src/lib/axis-api.ts) — the actual endpoint AXIS
# describes, as opposed to the ClientPortal session mimicry above. Tried
# first by getOrderByReferenceNumber() when AXIS_USERNAME/AXIS_PASSWORD (or
# AXIS_API_TOKEN) are set, falling back to the ClientPortal lookup on any
# failure. Defaults to https://skylinecourierlogistics.com/Xcelerator/Axis.
AXIS_API_BASE_URL=
# Reuses AXIS_USERNAME / AXIS_PASSWORD below for Basic auth by default. The
# exact Authorization header format is NOT confirmed from this deployment's
# Swagger doc alone (it only says "Add your Axis Bearer token here") — check
# the Web API Authorization Guide in the AXIS package (downloadable from
# inside Xcelerator) and, if it differs, paste the exact header value here
# (e.g. "Bearer xxxxx") to override the Basic-auth guess.
AXIS_API_TOKEN=

# OpenAI — used by src/lib/agent.ts to draft the "AI-suggested reply". The
# agent's only tool mirrors GET /api/orders/{referenceNumber}; without a key,
# replies fall back to the plain template in src/lib/email.ts.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# Missive (public REST API, Personal Access Token) — https://public.missiveapp.com/v1
# Used only by src/lib/missive.ts / GET /api/missive/conversation/{id} to read
# the subject + body of whichever email a CSR currently has open, when this
# app is embedded as a Missive integration panel (see MissiveEmailSense.tsx).
# That text is scanned client-side with detectOrderReferences() and only ever
# pre-fills the search box — it never auto-submits a lookup. Without this
# token set, the panel just falls back to "paste an email instead".
MISSIVE_API_TOKEN=

# Web agent (/web-agent page, src/lib/web-agent.ts): a headless browser signs
# in to the ClientPortal UI with the XCELERATOR_CALLER_N_* logins above and an
# OpenAI model clicks through Quick Track to read the order off the screen.
# Needs OPENAI_API_KEY. Uses the Chrome (or Edge) already installed; set
# WEB_AGENT_BROWSER_PATH to point at a specific browser binary instead.
WEB_AGENT_BROWSER_PATH=
# "chrome" or "msedge"; tries chrome then msedge when unset.
WEB_AGENT_BROWSER_CHANNEL=
# Set to "false" to watch the browser window while it works.
WEB_AGENT_HEADLESS=
# Model for the browsing loop; falls back to OPENAI_MODEL.
WEB_AGENT_MODEL=
# Learning (src/lib/web-agent-memory.ts): the agent learns which Quick Track
# field finds orders for each reference-number shape and searches that field
# first. Each login tries this many fields before giving up (default 3).
WEB_AGENT_MAX_SEARCHES=
# Chance (0-1) the last search slot explores a lower-ranked field (default
# 0.2). It rises automatically after lookups that found nothing.
WEB_AGENT_EXPLORE_RATE=
# Where the learned stats are saved (default .data/web-agent-memory.json).
# View them at GET /api/web-agent/memory, reset with DELETE on the same URL.
WEB_AGENT_MEMORY_FILE=
# "true" lets the model browse freely when every learned search misses. Slow.
WEB_AGENT_FREE_BROWSE=
# Max model actions for that free browsing (default 15).
WEB_AGENT_MAX_STEPS=
# Which sites may show /web-agent inside an iframe, space-separated, e.g.
# "https://mail.missiveapp.com https://app.example.com". Leave blank to allow
# any site. Inside a frame the page switches to a compact layout by itself
# (or add ?embed=1 to the URL to force it).
WEB_AGENT_FRAME_ANCESTORS=
